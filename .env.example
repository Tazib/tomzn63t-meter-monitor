# PostgreSQL connection
DATABASE_URL=postgres://smarthome:CHANGE_ME@localhost:5432/smarthome
# Docker only: password for the bundled Postgres (docker-compose builds DATABASE_URL from it)
POSTGRES_PASSWORD=

# Better Auth: random 32+ char secret (openssl rand -base64 32) and the public URL of the site
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Port the web app listens on under PM2 (Nginx proxies to it). Pick one no other app uses.
PORT=3100

# Tuya Cloud project (Central Europe data center)
TUYA_BASE_URL=https://openapi.tuyaeu.com
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=

# Poller interval in seconds (`npm run poller`)
POLL_INTERVAL_SECONDS=60
# Per-minute readings older than this are deleted (daily totals and bills are kept)
READINGS_RETENTION_DAYS=180

# First super admin (used by `npm run seed:admin`)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin
